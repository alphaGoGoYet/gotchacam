TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Telegram message language. Options: "en" (default), "fr". Add new ones by
# creating shared/strings.<lang>.json then setting LANGUAGE=<lang>.
LANGUAGE=en

CAMERA_INDEX=0
MOTION_THRESHOLD=25
MIN_AREA=5000
COOLDOWN_SECONDS=3
WARMUP_SECONDS=3
BURST_COUNT=3
BURST_INTERVAL=1.0

# Optional — prefix added to every Telegram message (useful if you run multiple cameras).
# Leave empty for no prefix.
SITE_NAME=

# Deterrent alarm (/alarm command) — output volume is forced to 100% during playback.
# ALARM_TEXT overrides the default text from shared/strings.<LANGUAGE>.json. Leave empty to use the localized default.
ALARM_TEXT=
# macOS TTS voice. Default depends on LANGUAGE (Daniel for en, Thomas for fr).
# To change, set explicitly. List available voices with `say -v "?"`.
ALARM_VOICE=
# Optional: absolute path to an audio file. If empty, the alarm looks for `alarm.m4a` next to cam.py.
# Formats: MP3, WAV, AIFF, M4A. The file takes priority over the TTS fallback.
ALARM_SOUND=

# Pitch shift automatically applied to /recordalarm recordings.
# 1.0 = no change. 0.75 = -25% (deeper, intimidating). 0.65 = -35% (very deep).
ALARM_PITCH=1.0

# Max duration (seconds) accepted for a /recordalarm voice message
ALARM_RECORD_MAX_SECONDS=30

# Path to the ffmpeg binary (used by /recordalarm and one-shot voice playback to
# convert Telegram OGG/Opus to WAV).
# Leave as "ffmpeg" if in PATH, otherwise full path (e.g., when installed via conda).
FFMPEG_BIN=ffmpeg

# Max duration (seconds) for one-shot playback of a received voice message
VOICE_PLAYBACK_MAX_SECONDS=60

# Retention period for files in `captures/`. On service start, files older than N days
# are deleted. Set to 0 to disable automatic cleanup.
RETENTION_DAYS=30
