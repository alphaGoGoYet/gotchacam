TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

CAMERA_INDEX=0
MOTION_THRESHOLD=25
MIN_AREA=5000
COOLDOWN_SECONDS=3
WARMUP_SECONDS=3
BURST_COUNT=3
BURST_INTERVAL=1.0

# Optionnel — préfixe ajouté à tous les messages Telegram (utile si tu as plusieurs caméras)
# Laisse vide pour aucun préfixe.
SITE_NAME=

# Alarme dissuasive (commande /alarm) — volume forcé à 100% pendant la diffusion
ALARM_TEXT=Alerte. Intrusion détectée. Cette zone est sous vidéo-surveillance haute définition. Vos images viennent d'être transmises à la police et au propriétaire. Le propriétaire arrive sur les lieux dans quelques minutes. Quittez immédiatement les lieux.
ALARM_VOICE=Thomas
# Optionnel : chemin absolu vers un fichier audio. Si vide, l'alarme cherchera `alarm.m4a` à côté de cam.py.
# Formats : MP3, WAV, AIFF, M4A. Le fichier est utilisé en priorité par /alarm ; sinon fallback sur ALARM_TEXT en TTS.
ALARM_SOUND=

# Pitch shift appliqué automatiquement aux enregistrements faits via /recordalarm.
# 1.0 = aucun changement. 0.75 = -25% (voix plus grave, intimidante). 0.65 = -35% (très grave).
ALARM_PITCH=1.0

# Durée max (secondes) acceptée pour un message vocal /recordalarm
ALARM_RECORD_MAX_SECONDS=30

# Chemin vers le binaire ffmpeg (utilisé par /recordalarm et la diffusion one-shot des
# messages vocaux pour convertir l'OGG/Opus Telegram en WAV).
# Laisse "ffmpeg" si dans le PATH, sinon mets le chemin complet (ex: installé via conda).
FFMPEG_BIN=ffmpeg

# Durée max (secondes) acceptée pour la diffusion one-shot d'un message vocal reçu
VOICE_PLAYBACK_MAX_SECONDS=60

# Durée de rétention des captures dans `captures/`. Au démarrage du service, les fichiers
# plus vieux que N jours sont supprimés. 0 = pas de nettoyage automatique.
RETENTION_DAYS=30
